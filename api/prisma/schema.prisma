generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  COACH
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum UserSex {
  MALE
  FEMALE
  OTHER
}

enum OnboardingGoal {
  FAT_LOSS
  MUSCLE_GAIN
  ENDURANCE
  MOBILITY
  GENERAL_FITNESS
  REHAB
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ExerciseCategory {
  STRENGTH
  CARDIO
  MOBILITY
  HIIT
  RECOVERY
}

enum ExerciseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ExerciseTrackingType {
  REPS
  TIME
  DISTANCE
  REPS_AND_TIME
}

enum GenderFocus {
  UNISEX
  FEMALE
  MALE
}

enum ExerciseScope {
  GLOBAL
  PRIVATE
}

enum MuscleGroup {
  FULL_BODY
  CHEST
  BACK
  SHOULDERS
  ARMS
  BICEPS
  TRICEPS
  CORE
  ABDOMEN
  FOREARM
  GLUTES
  LEGS
  QUADS
  HAMSTRINGS
  ADDUCTORS
  CALVES
}

enum WorkoutPlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  CANCELED
}

enum AuthProviderType {
  EMAIL_PASSWORD
  GOOGLE
  APPLE
  GITHUB
}

enum EventCategory {
  AUTH
  SECURITY
  ONBOARDING
  WORKOUT
  SYSTEM
}

enum PostPrivacy {
  PUBLIC
  FRIENDS
  PRIVATE
}

enum EventSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum SupportTicketTopic {
  ACCOUNT
  POST_REMOVED
  LOGIN
  BUG
  OTHER
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  AWAITING_USER
  RESOLVED
  CLOSED
}

enum SupportMessageAuthorRole {
  USER
  ADMIN
  SYSTEM
}

model User {
  id                  String          @id @default(cuid())
  email               String          @unique
  normalizedEmail     String          @unique
  // Public identifier shown as @handle in the feed/profile. Lowercase
  // alphanumeric + `._-`, 3–30 chars, enforced at the API layer.
  handle              String          @unique
  name                String?
  avatarUrl           String?
  passwordHash        String?
  sex                 UserSex         @default(OTHER)
  birthDate           DateTime?
  availableDaysPerWeek Int?
  onboardingCompletedAt DateTime?
  role                UserRole        @default(USER)
  status              AccountStatus   @default(PENDING)
  emailVerifiedAt     DateTime?
  mfaEnabled          Boolean         @default(false)
  failedLoginAttempts Int             @default(0)
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime?
  isPrivate           Boolean         @default(false)
  showFollowLists     Boolean         @default(true)
  isDeleted           Boolean         @default(false)
  deletedAt           DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  onboardingProfile OnboardingProfile?
  authProviders     AuthProvider[]
  workoutPlans      WorkoutPlan[]
  workoutSessions   WorkoutSession[]
  workoutHistories  WorkoutHistory[]
  cardioEntries     CardioEntry[]
  pinnedExercises   PinnedExercise[]
  bodyMeasurements  BodyMeasurement[]
  eventLogs         EventLog[]
  customExercises   Exercise[]
  followers         Follow[]         @relation("UserFollowing")
  following         Follow[]         @relation("UserFollowers")
  workoutPosts      WorkoutPost[]
  postLikes         PostLike[]
  postComments      PostComment[]
  sharedPlans       SharedPlan[]
  notifications     Notification[]
  supportTickets    SupportTicket[]
  supportMessages   SupportMessage[]
  supportTemplates  SupportTemplate[]

  @@index([status, isDeleted])
  @@index([role])
  @@index([lastLoginAt])
  @@index([onboardingCompletedAt])

  @@map("users")
}

model OnboardingProfile {
  id                  String          @id @default(cuid())
  userId              String          @unique
  goal                OnboardingGoal
  experienceLevel     ExperienceLevel
  age                 Int?
  heightCm            Float?
  weightKg            Float?
  preferredDaysPerWeek Int?
  injuries            Json?
  medicalNotes        String?
  consentAcceptedAt   DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goal, experienceLevel])
  @@map("onboarding_profiles")
}

model Exercise {
  id                   String             @id @default(cuid())
  slug                 String             @unique
  name                 String
  scope                ExerciseScope      @default(GLOBAL)
  ownerUserId          String?
  primaryMuscleGroup   MuscleGroup
  secondaryMuscleGroup MuscleGroup?
  genderFocus          GenderFocus        @default(UNISEX)
  equipment            String
  difficulty           ExerciseDifficulty @default(INTERMEDIATE)
  trackingType         ExerciseTrackingType @default(REPS)
  thumbnailUrl         String?
  videoUrl             String?
  instructions         String?
  isCompound           Boolean            @default(false)
  isBodyweight         Boolean            @default(false)
  allowsExtraLoad      Boolean            @default(false)
  isActive             Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  ownerUser User? @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  workoutPlanLinks WorkoutPlanExercise[]
  workoutHistory   WorkoutHistory[]
  pinnedByUsers    PinnedExercise[]

  @@index([scope, isActive])
  @@index([ownerUserId, scope])
  @@index([primaryMuscleGroup])
  @@index([secondaryMuscleGroup])
  @@index([difficulty])
  @@index([genderFocus])
  @@index([isActive])
  @@map("exercises")
}

model PinnedExercise {
  id         String   @id @default(cuid())
  userId     String
  exerciseId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId])
  @@index([userId, createdAt])
  @@index([exerciseId])
  @@map("pinned_exercises")
}

model BodyMeasurement {
  id                String   @id @default(cuid())
  userId            String
  date              DateTime
  photoUrl          String
  weight            Float
  chest             Float?
  shoulders         Float?
  arms              Float?
  forearms          Float?
  waist             Float?
  hips              Float?
  thighs            Float?
  calves            Float?
  neck              Float?
  bmi               Float?
  bodyFatPercentage Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("body_measurements")
}

model WorkoutPlan {
  id          String            @id @default(cuid())
  userId      String
  name        String
  description String?
  status      WorkoutPlanStatus @default(DRAFT)
  startsAt    DateTime?
  endsAt      DateTime?
  isTemplate  Boolean           @default(false)
  version     Int               @default(1)
  archivedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions WorkoutSession[]
  exercises WorkoutPlanExercise[]
  sharedPlans SharedPlan[]

  @@index([userId, status])
  @@index([startsAt, endsAt])
  @@map("workout_plans")
}

model WorkoutPlanExercise {
  id            String   @id @default(cuid())
  workoutPlanId String
  exerciseId    String
  orderIndex    Int
  sets          Int?
  repsMin       Int?
  repsMax       Int?
  durationSec   Int?
  restSec       Int?
  customName    String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workoutPlan WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  exercise    Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([workoutPlanId, orderIndex])
  @@index([exerciseId])
  @@map("workout_plan_exercises")
}

model WorkoutSession {
  id             String        @id @default(cuid())
  userId         String
  workoutPlanId  String?
  status         SessionStatus @default(SCHEDULED)
  scheduledAt    DateTime
  startedAt      DateTime?
  endedAt        DateTime?
  durationSec    Int?
  caloriesBurned Int?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutPlan WorkoutPlan?   @relation(fields: [workoutPlanId], references: [id], onDelete: SetNull)
  history     WorkoutHistory[]
  cardioEntries CardioEntry[]
  post        WorkoutPost?

  @@index([userId, scheduledAt])
  @@index([workoutPlanId, status])
  @@index([status, startedAt])
  @@map("workout_sessions")
}

enum CardioType {
  WALK
  RUN
  BIKE
  STAIRS
  ELLIPTICAL
  ROW
  JUMP_ROPE
  SWIM
  OTHER
}

// Atividade de cardio registrada dentro de uma sessão de treino. Separada do
// WorkoutHistory (que é por série de musculação) — cardio é tipo + duração.
model CardioEntry {
  id               String     @id @default(cuid())
  userId           String
  workoutSessionId String
  type             CardioType
  durationSec      Int
  distanceMeters   Float?
  calories         Int?
  notes            String?
  createdAt        DateTime   @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutSession WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([workoutSessionId])
  @@map("cardio_entries")
}

model WorkoutHistory {
  id              String   @id @default(cuid())
  userId          String
  workoutSessionId String
  exerciseId      String
  executionOrder  Int
  setNumber       Int
  reps            Int?
  weightKg        Float?
  durationSec     Int?
  distanceMeters  Float?
  perceivedExertion Int?
  notes           String?
  completedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutSession WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exercise      Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([userId, completedAt])
  @@index([exerciseId, completedAt])
  @@index([workoutSessionId, setNumber])
  @@index([workoutSessionId, executionOrder])
  @@map("workout_history")
}

model AuthProvider {
  id               String           @id @default(cuid())
  userId           String
  provider         AuthProviderType
  providerUserId   String
  accessTokenHash  String?
  refreshTokenHash String?
  tokenExpiresAt   DateTime?
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([userId, revokedAt])
  @@map("auth_providers")
}

model EventLog {
  id           String        @id @default(cuid())
  userId       String?
  category     EventCategory
  severity     EventSeverity @default(INFO)
  action       String
  resourceType String?
  resourceId   String?
  requestId    String?
  ipAddress    String?
  userAgent    String?
  message      String?
  metadata     Json?
  occurredAt   DateTime      @default(now())
  createdAt    DateTime      @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([category, severity, occurredAt])
  @@index([requestId])
  @@map("event_logs")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model WorkoutPost {
  id               String      @id @default(cuid())
  userId           String
  workoutSessionId String?     @unique
  caption          String?
  photoUrl         String?
  privacy          PostPrivacy @default(PUBLIC)
  likesCount       Int         @default(0)
  removedAt        DateTime?
  removedByAdminId String?
  removalReason    String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutSession WorkoutSession? @relation(fields: [workoutSessionId], references: [id], onDelete: SetNull)
  likes          PostLike[]
  comments       PostComment[]

  @@index([userId, createdAt])
  @@index([privacy, createdAt])
  @@index([removedAt])
  @@map("workout_posts")
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post WorkoutPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("post_likes")
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String   @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post WorkoutPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([userId])
  @@map("post_comments")
}

model SharedPlan {
  id        String    @id @default(cuid())
  planId    String
  creatorId String
  token     String    @unique @default(cuid())
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  plan    WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  creator User        @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([token])
  @@map("shared_plans")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model SupportTicket {
  id             String              @id @default(cuid())
  publicId       Int                 @unique @default(autoincrement())
  userId         String
  topic          SupportTicketTopic
  subject        String
  status         SupportTicketStatus @default(OPEN)
  lastActivityAt DateTime            @default(now())
  resolvedAt     DateTime?
  closedAt       DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([userId, status])
  @@index([status, lastActivityAt])
  @@map("support_tickets")
}

model SupportMessage {
  id             String                   @id @default(cuid())
  ticketId       String
  authorId       String?
  authorRole     SupportMessageAuthorRole
  body           String
  attachments    Json?
  isInternalNote Boolean                  @default(false)
  createdAt      DateTime                 @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

model SupportTemplate {
  id          String   @id @default(cuid())
  title       String
  body        String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@map("support_templates")
}
