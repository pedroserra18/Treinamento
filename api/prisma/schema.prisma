generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  COACH
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum UserSex {
  MALE
  FEMALE
  OTHER
}

// Objetivo PERMANENTE do usuário, definido no onboarding e editável em
// Configurações → Perfil. Diferente do "goal" passado pro quiz da IA
// (que é específico do plano que o user tá gerando agora). O perfil
// pré-preenche o quiz pra reduzir cliques, mas o quiz pode sobrescrever
// pra esse plano (ex.: tô em fase de cutting nesse mês).
enum PrimaryGoal {
  STRENGTH         // Força
  HYPERTROPHY      // Hipertrofia
  WEIGHT_LOSS      // Emagrecimento
  ENDURANCE        // Resistência
  GENERAL_FITNESS  // Saúde geral
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ExerciseCategory {
  STRENGTH
  CARDIO
  MOBILITY
  HIIT
  RECOVERY
}

enum ExerciseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ExerciseTrackingType {
  REPS
  TIME
  DISTANCE
  REPS_AND_TIME
}

enum GenderFocus {
  UNISEX
  FEMALE
  MALE
}

enum ExerciseScope {
  GLOBAL
  PRIVATE
}

enum MuscleGroup {
  FULL_BODY
  CHEST
  BACK
  SHOULDERS
  ARMS
  BICEPS
  TRICEPS
  CORE
  ABDOMEN
  FOREARM
  GLUTES
  LEGS
  QUADS
  HAMSTRINGS
  ADDUCTORS
  CALVES
}

enum WorkoutPlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  CANCELED
}

enum AuthProviderType {
  EMAIL_PASSWORD
  GOOGLE
  APPLE
  GITHUB
}

enum EventCategory {
  AUTH
  SECURITY
  ONBOARDING
  WORKOUT
  SYSTEM
  COMPETITION
}

enum PostPrivacy {
  PUBLIC
  FRIENDS
  PRIVATE
}

enum EventSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum SupportTicketTopic {
  ACCOUNT
  POST_REMOVED
  LOGIN
  BUG
  OTHER
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  AWAITING_USER
  RESOLVED
  CLOSED
}

enum SupportMessageAuthorRole {
  USER
  ADMIN
  SYSTEM
}

model User {
  id                  String          @id @default(cuid())
  email               String          @unique
  normalizedEmail     String          @unique
  // Public identifier shown as @handle in the feed/profile. Lowercase
  // alphanumeric + `._-`, 3–30 chars, enforced at the API layer.
  handle              String          @unique
  name                String?
  avatarUrl           String?
  passwordHash        String?
  sex                 UserSex         @default(OTHER)
  birthDate           DateTime?
  availableDaysPerWeek Int?
  // Onboarding profissional v2 — todos opcionais por design. heightCm e
  // weightKg ficam aqui (não em modelo separado) porque tem 1-1 com User,
  // cabem em qualquer SELECT e o quiz da IA pré-preenche a partir daqui.
  // experienceLevel afeta sugestões de carga e tom das recomendações;
  // primaryGoal default do quiz da IA (editável por plano).
  heightCm            Float?
  weightKg            Float?
  experienceLevel     ExperienceLevel?
  primaryGoal         PrimaryGoal?
  onboardingCompletedAt DateTime?
  role                UserRole        @default(USER)
  status              AccountStatus   @default(PENDING)
  emailVerifiedAt     DateTime?
  mfaEnabled          Boolean         @default(false)
  failedLoginAttempts Int             @default(0)
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime?
  isPrivate           Boolean         @default(false)
  showFollowLists     Boolean         @default(true)
  isDeleted           Boolean         @default(false)
  deletedAt           DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  authProviders     AuthProvider[]
  workoutPlans      WorkoutPlan[]
  aiGeneratedPlans  AIGeneratedPlan[]
  workoutSessions   WorkoutSession[]
  workoutHistories  WorkoutHistory[]
  cardioEntries     CardioEntry[]
  pinnedExercises   PinnedExercise[]
  bodyMeasurements  BodyMeasurement[]
  eventLogs         EventLog[]
  customExercises   Exercise[]
  followers         Follow[]         @relation("UserFollowing")
  following         Follow[]         @relation("UserFollowers")
  workoutPosts      WorkoutPost[]
  postLikes         PostLike[]
  postComments      PostComment[]
  sharedPlans       SharedPlan[]
  notifications     Notification[]
  notificationPreferences NotificationPreferences?
  pushSubscriptions PushSubscription[]
  scheduledNotifications ScheduledNotification[]
  supportTickets    SupportTicket[]
  supportMessages   SupportMessage[]
  supportTemplates  SupportTemplate[]
  competitionsOwned       Competition[]       @relation("CompetitionOwner")
  competitionMemberships  CompetitionMember[]
  competitionInvitesSent  CompetitionInvite[] @relation("CompetitionInviteSender")
  competitionInvitesReceived CompetitionInvite[] @relation("CompetitionInviteReceiver")
  competitionEntries      CompetitionEntry[]
  competitionMessages     CompetitionMessage[]
  competitionReactions    CompetitionEntryReaction[]
  competitionEntryComments CompetitionEntryComment[]
  competitionMemberStats  CompetitionMemberStats[]

  @@index([status, isDeleted])
  @@index([role])
  @@index([lastLoginAt])
  @@index([onboardingCompletedAt])

  @@map("users")
}

model Exercise {
  id                   String             @id @default(cuid())
  slug                 String             @unique
  name                 String
  scope                ExerciseScope      @default(GLOBAL)
  ownerUserId          String?
  primaryMuscleGroup   MuscleGroup
  secondaryMuscleGroup MuscleGroup?
  genderFocus          GenderFocus        @default(UNISEX)
  equipment            String
  difficulty           ExerciseDifficulty @default(INTERMEDIATE)
  trackingType         ExerciseTrackingType @default(REPS)
  thumbnailUrl         String?
  videoUrl             String?
  instructions         String?
  isCompound           Boolean            @default(false)
  isBodyweight         Boolean            @default(false)
  allowsExtraLoad      Boolean            @default(false)
  isActive             Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  ownerUser User? @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  workoutPlanLinks WorkoutPlanExercise[]
  workoutHistory   WorkoutHistory[]
  pinnedByUsers    PinnedExercise[]

  @@index([scope, isActive])
  @@index([ownerUserId, scope])
  @@index([primaryMuscleGroup])
  @@index([secondaryMuscleGroup])
  @@index([difficulty])
  @@index([genderFocus])
  @@index([isActive])
  @@map("exercises")
}

model PinnedExercise {
  id         String   @id @default(cuid())
  userId     String
  exerciseId String
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId])
  @@index([userId, orderIndex])
  @@index([userId, createdAt])
  @@index([exerciseId])
  @@map("pinned_exercises")
}

model BodyMeasurement {
  id                String   @id @default(cuid())
  userId            String
  date              DateTime
  photoUrl          String
  weight            Float
  chest             Float?
  shoulders         Float?
  arms              Float?
  forearms          Float?
  waist             Float?
  hips              Float?
  thighs            Float?
  calves            Float?
  neck              Float?
  bmi               Float?
  bodyFatPercentage Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("body_measurements")
}

model WorkoutPlan {
  id          String            @id @default(cuid())
  userId      String
  name        String
  description String?
  status      WorkoutPlanStatus @default(DRAFT)
  startsAt    DateTime?
  endsAt      DateTime?
  isTemplate  Boolean           @default(false)
  version     Int               @default(1)
  archivedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  // Marca planos criados na mesma "geração de IA" (ex.: FB 3x = 3 planos
  // com o mesmo aiGenerationId). aiGenerationLabel guarda a forma legível
  // pra UI ("Full Body 3x") sem precisar reconstruir do quiz. Ambos null
  // pra planos criados manualmente ou anteriores ao feature.
  aiGenerationId    String?
  aiGenerationLabel String?

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions WorkoutSession[]
  exercises WorkoutPlanExercise[]
  cardio   WorkoutPlanCardio[]
  sharedPlans SharedPlan[]

  @@index([userId, status])
  @@index([startsAt, endsAt])
  // Hot path do endpoint "últimas N gerações de IA": filtra por userId +
  // aiGenerationId not null, agrupa, ordena por createdAt desc.
  @@index([userId, aiGenerationId, createdAt])
  @@map("workout_plans")
}

// Histórico INDEPENDENTE de planos gerados pela IA. Auto-salvo sempre que
// o user gera um plano via quiz (não depende de clicar Salvar). 1 row =
// 1 dia da geração; planos multi-dia compartilham generationId. Mantém
// snapshot completo (planSnapshot Json) pra ser imune a mudanças no
// catálogo de Exercise depois — se o user voltar ano que vem e usar
// um plano antigo, ele aparece como foi gerado, não com nomes editados.
//
// SEPARADO de WorkoutPlan porque "rotinas" = só treinos que o user curou
// pra si; AI history fica isolado pra o user poder limpar /workouts sem
// perder o histórico. Quando user clica "Usar este treino" no AIWorkoutPage,
// um WorkoutPlan novo nasce a partir do snapshot (clone).
//
// Prune: o backend mantém só as últimas 20 gerações por user (pra evitar
// inflação infinita) — descartando as mais antigas no save.
model AIGeneratedPlan {
  id              String   @id @default(cuid())
  userId          String
  // Agrupa todos os dias de uma mesma geração ("FB 3x" = 3 rows com mesmo
  // generationId). Mesmo padrão do WorkoutPlan.aiGenerationId mas neste
  // modelo é obrigatório.
  generationId    String
  // Forma legível pra UI ("Full Body 3x"). Igual em todos os dias da
  // mesma geração.
  generationLabel String
  // Nome do dia específico (ex.: "Full Body A", "Push", "Lower").
  dayLabel        String
  // Posição do dia dentro da geração (0-indexed).
  dayIndex        Int
  // Nome do plano sugerido pela IA (igual planSnapshot.planName, em coluna
  // pra busca rápida sem ler JSON).
  planName        String
  // Snapshot completo: { planName, exercises: [{name, sets, repsMin,
  // repsMax, restSec, notes, muscleGroup, secondaryMuscleGroup}] }
  planSnapshot    Json
  generatedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, generatedAt])
  @@index([userId, generationId])
  @@map("ai_generated_plans")
}

// Cardio que faz parte do template da rotina (não de uma sessão concreta).
// Ao iniciar a rotina, essas entradas são pré-carregadas como sugestões na
// sessão ativa, onde o usuário confirma/ajusta antes de salvar.
model WorkoutPlanCardio {
  id               String     @id @default(cuid())
  workoutPlanId    String
  orderIndex       Int
  type             CardioType
  durationSec      Int
  distanceMeters   Float?
  notes            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  workoutPlan WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)

  @@unique([workoutPlanId, orderIndex])
  @@map("workout_plan_cardio")
}

model WorkoutPlanExercise {
  id            String   @id @default(cuid())
  workoutPlanId String
  exerciseId    String
  orderIndex    Int
  sets          Int?
  repsMin       Int?
  repsMax       Int?
  durationSec   Int?
  restSec       Int?
  customName    String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workoutPlan WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  exercise    Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([workoutPlanId, orderIndex])
  @@index([exerciseId])
  @@map("workout_plan_exercises")
}

model WorkoutSession {
  id             String        @id @default(cuid())
  userId         String
  workoutPlanId  String?
  status         SessionStatus @default(SCHEDULED)
  scheduledAt    DateTime
  startedAt      DateTime?
  endedAt        DateTime?
  durationSec    Int?
  caloriesBurned Int?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutPlan WorkoutPlan?   @relation(fields: [workoutPlanId], references: [id], onDelete: SetNull)
  history     WorkoutHistory[]
  cardioEntries CardioEntry[]
  post        WorkoutPost?
  competitionEntries CompetitionEntry[]

  @@index([userId, scheduledAt])
  // Hot path for /progress/summary?year=N — range-scans completed sessions
  // of a given user by endedAt. Without this it falls back to a seq scan
  // once a user has hundreds of sessions.
  @@index([userId, endedAt])
  @@index([workoutPlanId, status])
  @@index([status, startedAt])
  @@map("workout_sessions")
}

enum CardioType {
  WALK
  RUN
  BIKE
  STAIRS
  ELLIPTICAL
  ROW
  JUMP_ROPE
  SWIM
  OTHER
}

// Atividade de cardio registrada dentro de uma sessão de treino. Separada do
// WorkoutHistory (que é por série de musculação) — cardio é tipo + duração.
model CardioEntry {
  id               String     @id @default(cuid())
  userId           String
  workoutSessionId String
  type             CardioType
  durationSec      Int
  distanceMeters   Float?
  calories         Int?
  notes            String?
  createdAt        DateTime   @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutSession WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([workoutSessionId])
  @@map("cardio_entries")
}

model WorkoutHistory {
  id              String   @id @default(cuid())
  userId          String
  workoutSessionId String
  exerciseId      String
  executionOrder  Int
  setNumber       Int
  reps            Int?
  weightKg        Float?
  durationSec     Int?
  distanceMeters  Float?
  perceivedExertion Int?
  notes           String?
  completedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutSession WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exercise      Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([userId, completedAt])
  @@index([exerciseId, completedAt])
  @@index([workoutSessionId, setNumber])
  @@index([workoutSessionId, executionOrder])
  @@map("workout_history")
}

model AuthProvider {
  id               String           @id @default(cuid())
  userId           String
  provider         AuthProviderType
  providerUserId   String
  accessTokenHash  String?
  refreshTokenHash String?
  tokenExpiresAt   DateTime?
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([userId, revokedAt])
  @@map("auth_providers")
}

model EventLog {
  id           String        @id @default(cuid())
  userId       String?
  category     EventCategory
  severity     EventSeverity @default(INFO)
  action       String
  resourceType String?
  resourceId   String?
  requestId    String?
  ipAddress    String?
  userAgent    String?
  message      String?
  metadata     Json?
  occurredAt   DateTime      @default(now())
  createdAt    DateTime      @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([category, severity, occurredAt])
  @@index([requestId])
  @@map("event_logs")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model WorkoutPost {
  id               String      @id @default(cuid())
  userId           String
  workoutSessionId String?     @unique
  caption          String?
  photoUrl         String?
  privacy          PostPrivacy @default(PUBLIC)
  likesCount       Int         @default(0)
  removedAt        DateTime?
  removedByAdminId String?
  removalReason    String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutSession WorkoutSession? @relation(fields: [workoutSessionId], references: [id], onDelete: SetNull)
  likes          PostLike[]
  comments       PostComment[]

  @@index([userId, createdAt])
  @@index([privacy, createdAt])
  @@index([removedAt])
  @@map("workout_posts")
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post WorkoutPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("post_likes")
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String   @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post WorkoutPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([userId])
  @@map("post_comments")
}

model SharedPlan {
  id        String    @id @default(cuid())
  planId    String
  creatorId String
  token     String    @unique @default(cuid())
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  plan    WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  creator User        @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([token])
  @@map("shared_plans")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

// Cada device que aceitou notificações push tem uma row aqui. A unique
// é o `endpoint` (URL da push gateway específica do device + browser)
// porque um usuário pode ter N devices, mas cada endpoint é único no
// mundo. Quando o endpoint expira (push gateway responde 410), apagamos
// a row pelo unique.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

enum ScheduledNotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

// Preferências granulares de push notification, 1 row por usuário (1-1
// com User via @id). Default tudo true — usuário que ativa push no global
// recebe de todas categorias até desligar individualmente. lastInactivePushAt
// é usado pelo cron de "saudades" pra throttle (1 push a cada 7 dias máx).
model NotificationPreferences {
  userId                String   @id
  pushSocial            Boolean  @default(true)
  pushCompetition       Boolean  @default(true)
  pushSupport           Boolean  @default(true)
  pushEngagement        Boolean  @default(true)
  lastInactivePushAt    DateTime?
  lastAnniversaryPushAt DateTime?
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// Job de notificação agendada. O caso primário hoje é "descanso acabou":
// frontend cria a row com fireAt = startedAt + restSec quando o timer
// começa, e cancela se o user pula/recomeça. O worker do backend faz
// poll a cada 1s buscando rows com status='PENDING' e fireAt <= now,
// manda o push e marca como SENT. tag agrupa (notificações duplicadas
// do mesmo descanso colapsam no device); url é o deep-link do tap.
model ScheduledNotification {
  id        String                      @id @default(cuid())
  userId    String
  fireAt    DateTime
  title     String
  body      String
  url       String?
  tag       String?
  status    ScheduledNotificationStatus @default(PENDING)
  sentAt    DateTime?
  error     String?
  createdAt DateTime                    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, fireAt])
  @@index([userId, status])
  @@map("scheduled_notifications")
}

model SupportTicket {
  id             String              @id @default(cuid())
  publicId       Int                 @unique @default(autoincrement())
  userId         String
  topic          SupportTicketTopic
  subject        String
  status         SupportTicketStatus @default(OPEN)
  lastActivityAt DateTime            @default(now())
  resolvedAt     DateTime?
  closedAt       DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([userId, status])
  @@index([status, lastActivityAt])
  @@map("support_tickets")
}

model SupportMessage {
  id             String                   @id @default(cuid())
  ticketId       String
  authorId       String?
  authorRole     SupportMessageAuthorRole
  body           String
  attachments    Json?
  isInternalNote Boolean                  @default(false)
  createdAt      DateTime                 @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

model SupportTemplate {
  id          String   @id @default(cuid())
  title       String
  body        String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@map("support_templates")
}

// ─── Competition (challenge) ────────────────────────────────────────────────

enum CompetitionType {
  TRAINING
  CARDIO
  BOTH
}

enum CompetitionStatus {
  LOBBY
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CompetitionRole {
  ADMIN
  MEMBER
}

enum CompetitionInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum CompetitionEntryKind {
  TRAINING
  CARDIO
}

model Competition {
  id           String            @id @default(cuid())
  ownerUserId  String
  name         String?
  type         CompetitionType
  durationDays Int
  status       CompetitionStatus @default(LOBBY)
  // Hard deadline for the admin to start the competition. Defaulted to
  // createdAt + 3 days at the application layer. Cron / on-read check
  // auto-cancels rooms that pass this without being started.
  startDeadline DateTime?
  startedAt    DateTime?
  endsAt       DateTime?
  winnerUserId String?
  // External invite token used by share links. Generated once per competition
  // and rotatable by the owner if leaked.
  inviteToken  String            @unique @default(cuid())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  owner    User                @relation("CompetitionOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members  CompetitionMember[]
  invites  CompetitionInvite[]
  entries  CompetitionEntry[]
  messages CompetitionMessage[]
  memberStats CompetitionMemberStats[]

  // Hot path: "is this user already in any LOBBY/ACTIVE competition?" — the
  // partial unique on members below relies on the joined query staying cheap.
  @@index([ownerUserId])
  @@index([status, endsAt])
  @@map("competitions")
}

model CompetitionMember {
  id            String          @id @default(cuid())
  competitionId String
  userId        String
  role          CompetitionRole @default(MEMBER)
  joinedAt      DateTime        @default(now())
  // Soft-abandon flag. Strava-style: entries the user already posted
  // stay in the feed/history but they drop out of the leaderboard and
  // free up their "one active per user" slot.
  abandonedAt   DateTime?

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Two memberships for the same user in the same comp would break the
  // leaderboard. The "only one LOBBY/ACTIVE comp per user" rule is
  // enforced at the service layer using a Postgres SERIALIZABLE
  // transaction that re-checks user activity inside the same atomic
  // unit as the membership insert. Concurrent attempts hit Postgres's
  // serialization conflict detector and one aborts with code 40001,
  // which the service maps to a 409 with COMPETITION_ALREADY_IN_ANOTHER.
  //
  // A partial unique index would be cleaner here but Postgres doesn't
  // allow EXISTS subqueries inside partial-index WHERE clauses, and the
  // "is this competition still LOBBY/ACTIVE?" check needs a join.
  // The Serializable approach is equivalent at this scale without the
  // extra denormalization complexity.
  @@unique([competitionId, userId])
  @@index([userId, abandonedAt])
  @@map("competition_members")
}

model CompetitionInvite {
  id              String                  @id @default(cuid())
  competitionId   String
  invitedByUserId String
  // Null when the invite is link-only (external share). When set, the
  // invite is targeted and shows up in the recipient's notification feed.
  invitedUserId   String?
  token           String                  @unique @default(cuid())
  status          CompetitionInviteStatus @default(PENDING)
  expiresAt       DateTime
  createdAt       DateTime                @default(now())
  respondedAt     DateTime?

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  invitedBy   User        @relation("CompetitionInviteSender",   fields: [invitedByUserId], references: [id], onDelete: Cascade)
  invitedUser User?       @relation("CompetitionInviteReceiver", fields: [invitedUserId],   references: [id], onDelete: Cascade)

  @@index([invitedUserId, status])
  @@index([competitionId, status])
  @@map("competition_invites")
}

enum CompetitionReactionKind {
  CLAP   // 👏
  FIRE   // 🔥
  STRONG // 💪
  PRAY   // 🙏
}

model CompetitionEntryReaction {
  id        String                  @id @default(cuid())
  entryId   String
  userId    String
  kind      CompetitionReactionKind
  createdAt DateTime                @default(now())

  entry CompetitionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One reaction kind per user per entry. Re-acting with same kind = noop;
  // changing kind happens via delete + insert at the service layer.
  @@unique([entryId, userId, kind])
  @@index([entryId])
  @@map("competition_entry_reactions")
}

model CompetitionMessage {
  id            String   @id @default(cuid())
  competitionId String
  userId        String
  // Plain text only. Capped to 500 chars at the schema level so a single
  // message can't blow up the page. Profanity filter runs at the service
  // layer before insert.
  content       String   @db.VarChar(500)
  createdAt     DateTime @default(now())

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Hot path: load the most recent N messages in a room.
  @@index([competitionId, createdAt])
  @@index([userId])
  @@map("competition_messages")
}

model CompetitionEntry {
  id               String                @id @default(cuid())
  competitionId    String
  userId           String
  // Day key (UTC date). Combined with `kind` it's the uniqueness boundary:
  // one TRAINING + one CARDIO per day for BOTH-type competitions, single
  // entry per day for TRAINING-only / CARDIO-only.
  day              DateTime              @db.Date
  kind             CompetitionEntryKind
  workoutSessionId String?
  photoUrl         String
  // Storage path, retained so we can drop the underlying object if the
  // entry/competition is deleted (best-effort GC).
  photoPath        String?
  // SHA-256 of the raw photo bytes. Used to block users from reusing the
  // same photo as a previous day's proof — they have to provide fresh
  // proof per session.
  photoHash        String?
  createdAt        DateTime              @default(now())

  competition    Competition     @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutSession WorkoutSession? @relation(fields: [workoutSessionId], references: [id], onDelete: SetNull)
  reactions      CompetitionEntryReaction[]
  comments       CompetitionEntryComment[]

  @@unique([competitionId, userId, day, kind])
  @@index([competitionId, userId])
  @@index([userId, createdAt])
  // Fast lookup for "did this user already use this hash in this comp?"
  @@index([userId, photoHash])
  @@map("competition_entries")
}

// Materialised per-member aggregates so the standings endpoint becomes
// a cheap SELECT instead of recomputing across every entry on each call.
// The values are kept in sync by the service layer: any code path that
// inserts, updates, or deletes a CompetitionEntry calls
// recomputeMemberStats() inside the same transaction. Streak is NOT
// stored here — it's computed live in getStandings from the entries'
// day column so it can naturally decay when the user misses a day
// without us running a separate "tick the clock" job.
model CompetitionMemberStats {
  id               String   @id @default(cuid())
  competitionId    String
  userId           String
  // Distinct calendar days with at least one proof posted.
  daysActive       Int      @default(0)
  // Total proofs posted (1 per kind per day).
  points           Int      @default(0)
  // Sum of distinct workout-session durations (sec), deduped by session.
  totalDurationSec Int      @default(0)
  // Sum of distinct workout-session volumes (kg), deduped by session.
  // Stored as Int (rounded) since the leaderboard never shows decimals.
  volumeKg         Int      @default(0)
  updatedAt        DateTime @updatedAt

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([competitionId, userId])
  // Tiebreaker order matches the standings sort (days › points › time ›
  // volume) so the planner can serve a sorted scan straight from the
  // index when the room is hot.
  @@index([competitionId, daysActive, points, totalDurationSec, volumeKg])
  @@map("competition_member_stats")
}

model CompetitionEntryComment {
  id        String   @id @default(cuid())
  entryId   String
  userId    String
  // Plain text, capped at 500 chars at the DB level. Profanity filter runs
  // at the service layer like chat messages.
  content   String   @db.VarChar(500)
  createdAt DateTime @default(now())

  entry CompetitionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Hot path: load the comment thread for one entry, oldest → newest.
  @@index([entryId, createdAt])
  @@index([userId])
  @@map("competition_entry_comments")
}
