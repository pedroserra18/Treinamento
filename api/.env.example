NODE_ENV=development
API_PORT=4000
CLIENT_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
REDIS_URL=redis://localhost:6379

# Request protection
GLOBAL_RATE_LIMIT_MAX=100
LOGIN_BRUTE_FORCE_MAX=5
LOGIN_BRUTE_FORCE_WINDOW_MIN=15
LOGIN_PROGRESSIVE_BASE_MIN=3
LOGIN_PROGRESSIVE_MAX_MIN=60
AUTH_CODE_REQUEST_WINDOW_MIN=10
AUTH_CODE_REQUEST_MAX=5
AUTH_CODE_VERIFY_WINDOW_MIN=10
AUTH_CODE_VERIFY_MAX=10
OAUTH_STATE_TTL_MIN=10
ENFORCE_HTTPS=true

# Object storage (Supabase Storage). Optional in dev. To enable:
# 1. In the Supabase dashboard create a bucket (e.g. "acad-photos") set as Public.
# 2. Copy the project URL and the service_role key (Settings → API).
# 3. Set the three vars below; competition photos go to <bucket>/competition/<userId>/...
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Database (PostgreSQL)
# Replace USER/PASS/HOST/DB with your local or Supabase credentials.
DATABASE_URL=postgresql://USER:PASS@HOST:5432/DB?schema=public
DIRECT_URL=postgresql://USER:PASS@HOST:5432/DB?schema=public

# JWT (Access + Refresh)
JWT_SECRET=replace_with_strong_access_secret_min_32_chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=replace_with_strong_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=acad-api
JWT_AUDIENCE=acad-web

# Google OAuth
# 1. Crie credenciais em https://console.cloud.google.com/apis/credentials
#    Tipo "OAuth 2.0 Client ID" → Aplicação web
# 2. Em "Authorized redirect URIs" adicione exatamente a URL abaixo —
#    ela aponta pro FRONTEND (não pra API), porque é a página
#    GoogleCallbackPage que extrai o code/state e chama a API.
# 3. Copie Client ID e Client Secret pra cá.
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Email verification (registration with Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Acme <onboarding@your-domain.com>
EMAIL_VERIFICATION_TTL_MIN=10

# Monitoring / Observability
LOG_LEVEL=info
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=acad-api

# Cron — shared secret for /cron/* endpoints (min 32 chars). Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Wiring with Vercel Cron: in vercel.json add
#   { "crons": [{ "path": "/api/v1/cron/competition-reconcile", "schedule": "*/5 * * * *" }] }
# and Vercel will send Authorization: Bearer <CRON_SECRET> automatically.
# Leave empty to disable the cron endpoint entirely (it 503s).
CRON_SECRET=
