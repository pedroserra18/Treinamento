{
  "name": "acad-api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:prod": "prisma migrate deploy && node dist/server.js",
    "test:security": "node --import tsx --test tests/security.integration.test.ts",
    "test:auth": "node --import tsx --test tests/auth.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts --max-warnings=0",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:push": "prisma db push --accept-data-loss",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "prisma:reset": "prisma migrate reset --skip-seed=false",
    "test": "jest --runInBand",
    "test:integration": "jest --runInBand --config jest.config.cjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^10.69.0",
    "@supabase/supabase-js": "^2.112.2",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "exifr": "^7.1.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "express-xss-sanitizer": "^2.0.1",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "openai": "^6.49.0",
    "rate-limit-redis": "^4.3.1",
    "resend": "^6.18.1",
    "web-push": "^3.6.7",
    "winston": "^3.18.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "jest": "^30.4.2",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "sanitize-html": "^2.17.4"
  }
}
