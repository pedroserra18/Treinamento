#!/usr/bin/env sh

# 1. Bloqueia extensões perigosas em commits (DB dumps, chaves, binários).
# Adicionado depois do incidente com acad_backup.backup (Mai/2026) —
# esses tipos de arquivo NUNCA devem entrar no repo, mesmo gitignored.
forbidden=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -iE '\.(backup|dump|sql\.gz|sql\.bz2|pem|key|pfx|p12|keystore)$' || true)

if [ -n "$forbidden" ]; then
  echo "ERRO: arquivos com extensão proibida no commit:"
  echo "$forbidden"
  echo ""
  echo "Esses tipos de arquivo nunca devem ser commitados."
  echo "Se foi por engano: git restore --staged <arquivo>"
  exit 1
fi

# 2. Varre conteúdo de arquivos staged em busca de segredos (API keys,
# tokens AWS/GCP/Stripe/etc, JWT em texto claro, chaves privadas, senhas).
staged=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -n "$staged" ]; then
  echo "$staged" | xargs npx secretlint --secretlintignore .gitignore || exit 1
fi

# 3. Lembrete NAO-BLOQUEANTE: se a ESTRUTURA de arquivos mudou (add/remove/
# rename em pastas-chave), lembra de conferir docs/CODE_MAP.md. So dispara em
# mudanca estrutural (nao em edicao de conteudo). Roda ANTES do gate lint/
# typecheck pra nunca alterar o exit code do hook (nunca bloqueia o commit).
structural=$(git diff --cached --name-only --diff-filter=ADR \
  | grep -E '^(frontend-vite/src/pages/|frontend-vite/src/services/|frontend-vite/src/hooks/|frontend-vite/src/components/|api/src/modules/)' || true)
if [ -n "$structural" ]; then
  echo "LEMBRETE: estrutura de arquivos mudou — confira se docs/CODE_MAP.md precisa atualizar:"
  echo "$structural" | sed 's/^/  /'
  echo ""
fi

# 4. Qualidade de código (lint + typecheck) — herdado do hook anterior.
npm run lint
npm run typecheck
