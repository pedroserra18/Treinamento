VITE_API_URL=http://localhost:4000/api/v1
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.2

# Habilita Supabase Storage Image Transformations (requer plano Pro).
# Quando "true", o helper imageTransform.ts gera URLs com /render/image/
# pra servir thumbnails. Em false (default), serve a foto original.
VITE_SUPABASE_TRANSFORM_ENABLED=false

# Supabase Realtime — quando preenchidos, a página de desafio substitui
# polling de 12s por subscriptions de Postgres changes (chat, feed,
# reactions, comments). Anon key (NÃO o service_role) — o frontend
# nunca deve ter o service role. Habilite "Realtime" no dashboard para:
#   public.competition_entries
#   public.competition_entry_reactions
#   public.competition_entry_comments
#   public.competition_messages
# E configure RLS policies pra anon SELECT (writes continuam pela API).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Para login Google no frontend, configure na API o GOOGLE_CALLBACK_URL apontando para:
# http://localhost:3000/auth/google/callback
